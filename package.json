{
  "name": "dsh-dafeiyu-entry",
  "version": "1.0.0",
  "description": "大肥鱼 QQ 主机控制台：在 DeepSeek Harness 设置侧栏提供主机状态、聊天记录、机器人配置与加好友二维码。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "dafeiyu",
    "qqbot",
    "qq",
    "dsh-client"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-client-ui-settings": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-client-ui-settings": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TomCatV/dsh-dafeiyu-entry.git"
  },
  "homepage": "https://github.com/TomCatV/dsh-dafeiyu-entry#readme",
  "bugs": {
    "url": "https://github.com/TomCatV/dsh-dafeiyu-entry/issues"
  }
}
